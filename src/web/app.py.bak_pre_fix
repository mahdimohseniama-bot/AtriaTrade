        }
        .mode-btn {
            flex: 1; border: none; background: transparent; color: var(--text-muted);
            padding: 7px; border-radius: 8px; font-size: 0.75rem; font-weight: 700;
            cursor: pointer; transition: all 0.2s; font-family: var(--font-main);
        }
        .mode-btn.active { background: var(--primary); color: white; }

        select, input.sub-input {
            width: 100%; padding: 9px; border-radius: 10px; border: 1px solid var(--card-border);
            background: rgba(0,0,0,0.35); color: white; font-family: var(--font-main); font-size: 0.8rem; outline: none;
        }

        /* Tables & Logs */
        .data-panel { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; }
        @media (max-width: 900px) { .data-panel { grid-template-columns: 1fr; } }

        table { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
        th { text-align: right; color: var(--text-muted); padding: 8px 4px; border-bottom: 1px solid var(--card-border); }
        td { padding: 8px 4px; border-bottom: 1px solid rgba(255, 255, 255, 0.03); font-family: var(--font-mono); }
        
        .pnl-pos { color: var(--accent-green); font-weight: 700; }
        .pnl-neg { color: var(--accent-red); font-weight: 700; }

        .logs-box {
            height: 180px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px;
            font-family: var(--font-mono); font-size: 0.73rem;
        }
        .log-item { display: flex; gap: 8px; line-height: 1.4; border-bottom: 1px dashed rgba(255, 255, 255, 0.04); padding-bottom: 4px; }
        .log-time { color: var(--text-muted); }
        .log-lvl { font-weight: 700; padding: 1px 4px; border-radius: 4px; font-size: 0.62rem; }
        .lvl-trade { background: rgba(59, 130, 246, 0.2); color: #93c5fd; }
        .lvl-risk { background: rgba(239, 68, 68, 0.2); color: #fca5a5; }
        .lvl-withdraw { background: rgba(245, 158, 11, 0.2); color: #fde68a; }
        .lvl-panic { background: #dc2626; color: white; }
    </style>
</head>
<body>

