import asyncio
import os
import random
import time
import secrets
from datetime import datetime
from typing import Dict, Any, List, Optional
from fastapi import FastAPI, Request, BackgroundTasks, HTTPException, Response, Cookie
from fastapi.responses import HTMLResponse, JSONResponse
from pydantic import BaseModel

app = FastAPI(title="AtriaTrade Master Secured Cockpit", version="2.5.0")

# Security Secret
AUTH_PIN = os.getenv("ATRIA_AUTH_PIN", "atria2026")
ACTIVE_SESSIONS = set()

# ================= Global Trading State Engine =================
class TradingState:
    def __init__(self):
        self.bot_status: str = "STOPPED"  # RUNNING, PAUSED, STOPPED
        self.mode: str = "AUTO"           # AUTO, MANUAL, SEMI_AUTO
        self.active_exchange: str = "Nobitex (Paper)"  # Nobitex, Binance, Wallex
        self.balance_usdt: float = 10000.0
        self.initial_balance: float = 10000.0
        self.equity: float = 10000.0
        self.vault_balance: float = 0.0
        self.total_withdrawn: float = 0.0
        self.current_symbol: str = "BTC/USDT"
        self.current_price: float = 64250.0
        self.leverage: int = 5
        self.positions: Dict[str, Any] = {}
        self.trades_history: List[Dict[str, Any]] = []
        self.withdraw_history: List[Dict[str, Any]] = []
        self.logs: List[Dict[str, str]] = []
        self.active_strategy: str = "ICT Macro & SMC OrderBlock"
        self.risk_per_trade: float = 1.5  # 1.5%
        self.chart_history: List[Dict[str, Any]] = []
        self.last_signal: str = "SMC_BULLISH_SWEEP"
        self.win_count: int = 0
        self.loss_count: int = 0
        
        # Initialize Chart Seed Data
        base_price = 63900.0
        now = int(time.time())
        for i in range(40):
            t = now - (40 - i) * 60
            base_price += random.uniform(-40, 45)
            self.chart_history.append({"time": t, "price": round(base_price, 2)})
        self.current_price = self.chart_history[-1]["price"]
        self.add_log("System", "AtriaTrade Secured Core Active. Ready for Zero-Risk Simulated Testing.")

    def add_log(self, level: str, message: str):
        now_str = datetime.now().strftime("%H:%M:%S")
        self.logs.insert(0, {"time": now_str, "level": level, "msg": message})
        if len(self.logs) > 60:
            self.logs.pop()

    def update_price(self):
        delta = random.uniform(-35, 37)
        self.current_price = round(max(100.0, self.current_price + delta), 2)
        now = int(time.time())
        self.chart_history.append({"time": now, "price": self.current_price})
        if len(self.chart_history) > 60:
            self.chart_history.pop(0)

        # Update open position unrealized PnL with leverage
        if "BTC/USDT" in self.positions:
            pos = self.positions["BTC/USDT"]
            entry = pos["entry_price"]
            amt = pos["amount"]
            side = pos["side"]
            lev = pos.get("leverage", 1)
            raw_diff = (self.current_price - entry) if side == "BUY" else (entry - self.current_price)
            pos["unrealized_pnl"] = round(raw_diff * amt * lev, 2)
            pos["pnl_pct"] = round((raw_diff / entry) * 100 * lev, 2)
            self.equity = round(self.balance_usdt + pos["unrealized_pnl"], 2)
        else:
            self.equity = round(self.balance_usdt, 2)

    def execute_market_order(self, symbol: str, side: str, amount: Optional[float] = None) -> bool:
        if amount is None or amount <= 0:
            cost = self.balance_usdt * (self.risk_per_trade / 100.0)
            amount = round(cost / self.current_price, 4)

        if amount <= 0:
            self.add_log("Risk", "Order rejected: Amount too small.")
            return False

        cost = amount * self.current_price
        if side == "BUY":
            if self.balance_usdt < cost:
                self.add_log("Risk", f"Order rejected: Insufficient Balance (${self.balance_usdt:.2f} < ${cost:.2f})")
                return False
            self.balance_usdt = round(self.balance_usdt - cost, 2)
            self.positions[symbol] = {
                "symbol": symbol,
                "side": "BUY",
                "amount": amount,
                "leverage": self.leverage,
                "entry_price": self.current_price,
                "unrealized_pnl": 0.0,
                "pnl_pct": 0.0,
                "time": datetime.now().strftime("%H:%M:%S")
            }
            self.add_log("Trade", f"Executed MARKET BUY {amount} {symbol} ({self.leverage}x) @ ${self.current_price:,.2f}")
            return True
        elif side == "SELL":
            if symbol not in self.positions:
                self.add_log("Trade", f"No open position to close for {symbol}")
                return False
            pos = self.positions.pop(symbol)
            lev = pos.get("leverage", 1)
            pnl = ((self.current_price - pos["entry_price"]) if pos["side"] == "BUY" else (pos["entry_price"] - self.current_price)) * pos["amount"] * lev
            pnl = round(pnl, 2)
            self.balance_usdt = round(self.balance_usdt + (pos["amount"] * pos["entry_price"]) + pnl, 2)
            
            # Safe Vault auto-transfer 25% of net profit
            vault_cut = 0.0
            if pnl > 0:
                vault_cut = round(pnl * 0.25, 2)
                self.vault_balance = round(self.vault_balance + vault_cut, 2)
                self.balance_usdt = round(self.balance_usdt - vault_cut, 2)
                self.win_count += 1
            else:
                self.loss_count += 1

            trade_record = {
                "id": len(self.trades_history) + 1,
                "symbol": symbol,
                "side": pos["side"],
                "entry": pos["entry_price"],
                "exit": self.current_price,
                "amount": pos["amount"],
                "pnl": pnl,
                "vault_cut": vault_cut,
                "pnl_pct": round((pnl / (pos["amount"] * pos["entry_price"])) * 100, 2),
                "time": datetime.now().strftime("%H:%M:%S")
            }
            self.trades_history.insert(0, trade_record)
            if len(self.trades_history) > 30:
                self.trades_history.pop()
            
            msg = f"Closed {symbol} Net PnL: ${pnl:+.2f} ({trade_record['pnl_pct']:+.2f}%)"
            if vault_cut > 0:
                msg += f" | Vault Reserve: +${vault_cut:.2f}"
            self.add_log("Trade", msg)
            return True
        return False

    def deposit_funds(self, amount: float):
        if amount > 0:
            self.balance_usdt = round(self.balance_usdt + amount, 2)
            self.equity = round(self.equity + amount, 2)
            self.add_log("Wallet", f"Deposit Confirmed: +${amount:,.2f} USDT")
            return True
        return False

    def withdraw_funds(self, amount: float, target_address: str):
        if amount <= 0:
            return False, "Invalid amount"
        if amount > self.vault_balance and amount > self.balance_usdt:
            return False, "Insufficient balance"
        
        # Withdraw priority: from Vault first, then balance
        if self.vault_balance >= amount:
            self.vault_balance = round(self.vault_balance - amount, 2)
        else:
            rem = amount - self.vault_balance
            self.vault_balance = 0.0
            self.balance_usdt = round(self.balance_usdt - rem, 2)

        self.total_withdrawn = round(self.total_withdrawn + amount, 2)
        rec = {
            "amount": amount,
            "address": target_address[:6] + "..." + target_address[-4:] if len(target_address) > 10 else target_address,
            "time": datetime.now().strftime("%H:%M:%S"),
            "status": "COMPLETED (Simulated)"
        }
        self.withdraw_history.insert(0, rec)
        self.add_log("Withdraw", f"Transferred ${amount:,.2f} USDT to {rec['address']}")
        return True, "Success"

    def panic_close_all(self):
        symbols = list(self.positions.keys())
        for sym in symbols:
            self.execute_market_order(sym, "SELL")
        self.bot_status = "STOPPED"
        self.add_log("PANIC", "EMERGENCY PANIC TRIGGERED: All active positions liquidated immediately.")

state = TradingState()

# ================= Background Simulation Loop =================
async def trading_engine_loop():
    while True:
        state.update_price()
        if state.bot_status == "RUNNING" and state.mode in ["AUTO", "SEMI_AUTO"]:
            roll = random.random()
            if "BTC/USDT" not in state.positions:
                if roll < 0.14:  # Entry Signal
                    strategies = ["ICT Silver Bullet FVG", "SMC Liquidity Sweep", "OrderBlock Mitigation"]
                    state.last_signal = f"STRONG BUY ({random.choice(strategies)})"
                    state.execute_market_order("BTC/USDT", "BUY")
            else:
                pos = state.positions["BTC/USDT"]
                # Take profit / Stop loss or Auto Trail
                if pos["pnl_pct"] >= 2.2 or pos["pnl_pct"] <= -1.1 or roll < 0.09:
                    state.last_signal = "TAKE PROFIT / EXIT TRIGGER"
                    state.execute_market_order("BTC/USDT", "SELL")
        await asyncio.sleep(2)

@app.on_event("startup")
async def startup_event():
    asyncio.create_task(trading_engine_loop())

