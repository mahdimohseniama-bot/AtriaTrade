        /* Main Cockpit Layout */
        .cockpit-grid {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 16px;
        }
        @media (max-width: 960px) { .cockpit-grid { grid-template-columns: 1fr; } }

        /* Chart */
        .chart-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
