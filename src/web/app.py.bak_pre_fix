# ================= API Schemas =================
class LoginRequest(BaseModel):
    pin: str

class OrderRequest(BaseModel):
    symbol: str = "BTC/USDT"
    side: str
    amount: Optional[float] = None

class ModeRequest(BaseModel):
    mode: str

class ConfigRequest(BaseModel):
    exchange: Optional[str] = None
    strategy: Optional[str] = None
    leverage: Optional[int] = None
    risk: Optional[float] = None

class DepositRequest(BaseModel):
    amount: float

class WithdrawRequest(BaseModel):
    amount: float
    address: str

# ================= Security & Auth Endpoints =================
@app.post("/api/auth/login")
def login(req: LoginRequest, response: Response):
    if req.pin == AUTH_PIN:
        token = secrets.token_hex(16)
        ACTIVE_SESSIONS.add(token)
        response.set_cookie(key="atria_session", value=token, httponly=True, max_age=86400*7)
        return {"status": "ok", "token": token}
    return JSONResponse(status_code=401, content={"error": "رمز عبور اشتباه است"})

@app.get("/api/auth/check")
def check_auth(atria_session: Optional[str] = Cookie(None)):
    if atria_session and atria_session in ACTIVE_SESSIONS:
        return {"authenticated": True}
    return {"authenticated": False}

# ================= Management Endpoints =================
@app.get("/api/status")
def getadd_log("Engine", f"Bot started in {state.mode} on {state.active_exchange}.")
    return {"status": "ok", "bot_status": state.bot_status}

@app.post("/api/bot/stop")
def stop_bot():
    state.bot_status = "STOPPED"
    state.add_log("Engine", "Bot paused by operator.")
    return {"status": "ok", "bot_status": state.bot_status}

@app.post("/api/bot/set_mode")
def set_mode(req: ModeRequest):
    if req.mode in ["AUTO", "MANUAL", "SEMI_AUTO"]:
        state.mode = req.mode
        state.add_log("Mode", f"Operation mode switched to {req.mode}")
        return {"status": "ok", "mode": state.mode}
    return JSONResponse(status_code=400, content={"error": "Invalid mode"})

@app.post("/api/bot/config")
def update_config(req: ConfigRequest):
    if req.exchange: state.active_exchange = req.exchange
    if req.strategy: state.active_strategy = req.strategy
    if req.leverage: state.leverage = req.leverage
    if req.risk: state.risk_per_trade = req.risk
    state.add_log("Config", f"Config updated: Exch={state.active_exchange}, Lev={state.leverage}x, Strat={state.active_strategy}")
    return {"status": "ok"}

@app.post("/api/trade/market")
def place_market_order(req: OrderRequest):
    success = state.execute_market_order(req.symbol, req.side.upper(), req.amount)
    return {"status": "ok" if success else "failed"}

@app.post("/api/trade/panic")
def panic_kill():
    state.panic_close_all()
    return {"status": "ok", "message": "All positions liquidated"}

@app.post("/api/wallet/deposit")
def wallet_deposit(req: DepositRequest):
    ok = state.deposit_funds(req.amount)
    return {"status": "ok" if ok else "failed"}

@app.post("/api/wallet/withdraw")
def wallet_withdraw(req: WithdrawRequest):
    ok, msg = state.withdraw_funds(req.amount, req.address)
    if ok:
        return {"status": "ok", "message": msg}
    return JSONResponse(status_code=400, content={"error": msg})

# ================= Master Secured Cockpit Frontend =================
@app.get("/", response_class=HTMLResponse)
def index_page():
    return """<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AtriaTrade Pro • Secured Trading Station</title>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;600;800;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-base: #070a14;
            --card-bg: rgba(15, 23, 42, 0.75);
            --card-border: rgba(255, 255, 255, 0.08);
            --primary: #3b82f6;
            --primary-glow: rgba(59, 130, 246, 0.4);
            --accent-green: #10b981;
            --accent-red: #ef4444;
            --accent-gold: #f59e0b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --font-main: 'Vazirmatn', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-base);
            background-image: 
                radial-gradient(circle at 10% 20%, rgba(59, 130, 246, 0.12) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(16, 185, 129, 0.1) 0%, transparent 40%);
            color: var(--text-main);
            font-family: var(--font-main);
            min-height: 100vh;
            padding: 16px;
        }

        .container { max-width: 1400px; margin: 0 auto; display: flex; flex-direction: column; gap: 16px; }

        /* Login Overlay */
        #loginOverlay {
            position: fixed; inset: 0; background: rgba(7, 10, 20, 0.92);
            backdrop-filter: blur(20px); z-index: 9999;
            display: flex; align-items: center; justify-content: center; padding: 16px;
        }
        .login-card {
            background: rgba(30, 41, 59, 0.9); border: 1px solid var(--card-border);
            border-radius: 24px; padding: 32px; width: 100%; max-width: 400px;
            text-align: center; box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        }
        .login-icon { font-size: 3rem; margin-bottom: 12px; }
        .pin-input {
            width: 100%; padding: 14px; border-radius: 12px; border: 1px solid var(--card-border);
            background: rgba(0,0,0,0.4); color: white; text-align: center;
            font-size: 1.2rem; font-family: var(--font-mono); margin: 16px 0; outline: none;
        }
        .pin-input:focus { border-color: var(--primary); }

        /* Glass Cards */
        .glass-card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--card-border);
            border-radius: 18px;
            padding: 18px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        /* Header Bar */
        header { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; }
        .brand { display: flex; align-items: center; gap: 12px; }
        .logo-badge {
            width: 46px; height: 46px; border-radius: 14px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            display: flex; align-items: center; justify-content: center;
            font-weight: 900; font-size: 22px; box-shadow: 0 0 20px var(--primary-glow);
        }
        .brand-title { font-size: 1.25rem; font-weight: 800; }
        .brand-sub { font-size: 0.75rem; color: var(--text-muted); }

        .system-pill {
            display: flex; align-items: center; gap: 8px;
            padding: 6px 14px; border-radius: 30px;
            font-size: 0.8rem; font-weight: 600;
            background: rgba(255, 255, 255, 0.04); border: 1px solid var(--card-border);
        }
        .status-dot { width: 10px; height: 10px; border-radius: 50%; }
        .dot-running { background: var(--accent-green); box-shadow: 0 0 10px var(--accent-green); }
        .dot-stopped { background: var(--accent-red); box-shadow: 0 0 10px var(--accent-red); }

        /* Metric Grid */
        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 12px;
        }
        .metric-card {
            display: flex; flex-direction: column; gap: 4px;
            position: relative; overflow: hidden;
        }
        .metric-card::after {
            content: ''; position: absolute; top: 0; right: 0; width: 4px; height: 100%;
            background: var(--primary);
        }
        .metric-card.gold::after { background: var(--accent-gold); }
        .metric-card.green::after { background: var(--accent-green); }
        .metric-card.purple::after { background: #a855f7; }
        .metric-label { font-size: 0.72rem; color: var(--text-muted); }
