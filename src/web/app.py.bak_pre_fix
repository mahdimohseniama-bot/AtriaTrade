        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <div class="system-pill">
                <span>صرافی:</span>
                <span id="exchBadge" style="color: #a855f7; font-weight:700;">Nobitex (Paper)</span>
            </div>
            <div class="system-pill">
                <span>سیگنال:</span>
                <span id="signalBadge" style="color: #38bdf8; font-family: var(--font-mono);">ANALYZING</span>
            </div>
            <div class="system-pill">
                <div id="statusDot" class="status-dot dot-stopped"></div>
                <span id="statusText">STOPPED</span>
            </div>
        </div>
    </header>

    <!-- Metrics Grid -->
    <div class="metrics-grid">
        <div class="glass-card metric-card">
            <div class="metric-label">موجودی آزاد (USDT)</div>
            <div id="metricBalance" class="metric-val">10,000.00</div>
        </div>
        <div class="glass-card metric-card green">
            <div class="metric-label">ارزش کل اکوئیتی (Equity)</div>
            <div id="metricEquity" class="metric-val">10,000.00</div>
        </div>
        <div class="glass-card metric-card gold">
            <div class="metric-label">صندوق ذخیره سود (Safe Vault)</div>
            <div id="metricVault" class="metric-val">0.00</div>
        </div>
        <div class="glass-card metric-card purple">
            <div class="metric-label">مجموع برداشت سود (Withdraws)</div>
            <div id="metricWithdrawn" class="metric-val">0.00</div>
        </div>
        <div class="glass-card metric-card">
            <div class="metric-label">سود/زیان کل خالص (Total PnL)</div>
            <div id="metricPnL" class="metric-val">+0.00 USDT</div>
        </div>
        <div class="glass-card metric-card">
            <div class="metric-label">وین‌ریت (Win Rate)</div>
            <div id="metricWinRate" class="metric-val">0.0%</div>
        </div>
    </div>

    <!-- Main Cockpit -->
    <div class="cockpit-grid">
        <!-- Chart -->
        <div class="glass-card">
            <div class="chart-header">
                <div>
                    <span style="font-weight: 800; font-size: 1.1rem;">نمودار زنده BTC/USDT</span>
                    <span style="font-size: 0.75rem; color: var(--text-muted); margin-right: 6px;">(شبیه‌ساز ترید زنده)</span>
                </div>
                <div id="livePrice" class="live-price">$0.00</div>
            </div>
            <canvas id="priceChart"></canvas>
            
            <!-- Deposit / Withdraw Bar -->
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-top:14px; padding-top:12px; border-top:1px solid var(--card-border);">
                <div>
                    <div class="section-title">واریز سرم="metric-label">وین‌ریت (Win Rate)</div>
            <div id="metricWinRate" class="metric-val">0.0%</div>
        </div>
    </div>

    <!-- Main Cockpit -->
    <div class="cockpit-grid">
        <!-- Chart -->
        <div class="glass-card">
            <div class="chart-header">
                <div>
                    <span style="font-weight: 800; font-size: 1.1rem;">نمودار زنده BTC/USDT</span>
                    <span style="font-size: 0.75rem; color: var(--text-muted); margin-right: 6px;">(شبیه‌ساز ترید زنده)</span>
                </div>
                <div id="livePrice" class="live-price">$0.00</div>
            </div>
            <canvas id="priceChart"></canvas>
            
            <!-- Deposit / Withdraw Bar -->
            <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-top:14px; padding-top:12px; border-top:1px solid var(--card-border);">
                <div>
                    <div class="section-title">واریز سرمایه آزمایشی (Deposit)</div>
                    <div style="display:flex; gap:6px;">
                        <input type="number" id="depositAmt" class="sub-input" placeholder="مبلغ USDT" value="1000">
                        <button class="btn btn-start" style="padding:0 16px;" onclick="doDeposit()">واریز</button>
                    </div>
                </div>
                <div>
                    <div class="section-title">برداشت مستقیم سود به ولت (Withdraw)</div>
                    <div style="display:flex; gap:6px;">
                        <input type="text" id="withdrawAddr" class="sub-input" placeholder="آدرس ولت (TRC20/BEP20)" value="0x89Atria...7F2b">
                        <input type="number="10">اهرم 10x (Pro)</option>
                </select>
            </div>

            <div class="section-title">حالت عملیاتی ربات (Operation Mode)</div>
            <div class="mode-selector">
                <button class="mode-btn active" onclick="setMode('AUTO')">تمام خودکار (Auto)</button>
                <button class="mode-btn" onclick="setMode('SEMI_AUTO')">نیمه خودکار</button>
                <button class="mode-btn" onclick="setMode('MANUAL')">دستی (Manual)</button>
            </div>

            <div class="section-title">فرمان‌های هسته ربات</div>
            <div class="btn-row">
                <button class="btn btn-start" onclick="startBot()">▶ روشن کردن بات</button>
                <button class="btn btn-stop" onclick="stopBot()">⏹ توقف موقت</button>
            </div>

            <div class="section-title">معامله سریع آنی (Instant Execution)</div>
            <div class="btn-row">
                <button class="btn btn-buy" onclick="marketOrder('BUY')">🟢 خرید سریع (Long)</button>
                <button class="btn btn-sell" onclick="marketOrder('SELL')">🔴 بستن/فروش (Short)</button>
                <button class="btn btn-panic" onclick="panicKill()">🚨 خروج اضطراری (PANIC CLOSE ALL)</button>
            </div>
        </div>
    </div>

    <!-- Trades & Live Logs -->
    <div class="data-panel">
        <!-- Open Position & History -->
        <div class="glass-card">
            <div class="section-title">پوزیشن‌های فعال و گزارش تراکنش‌ها</div>
            <table>
                <thead>
                    <tr>
                        <th>نماد</th>
                        <th>نوع</th>
                        <th>ورود</th>
                        <th>خروج</th>
                        <th>سود/زیان</th>
                        <th>زمان</th>
                    </tr>
                </thead>
                <tbody id="tradesBody">
                    <tr><td colspan="6" style="text-align: center; color: var(--text-muted);">داده‌ای وجود ندارد</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Live Engine Logs -->
        <div class="glass-card">
            <div class="section-title">کنسول لاگ زنده سیستم (Real-Time Engine Logs)</div>
            <div class="logs-box" id="logsBox"></div>
        </div>
    </div>
</div>

<script>
    let chartCanvas = document.getElementById('priceChart');
    let ctx = chartCanvas.getContext('2d');

    async function checkAuth() {
        try {
            const res = await fetch('/api/auth/check');
            const data = await res.json();
            if (data.authenticated) {
                document.getElementById('loginOverlay').style.display = 'none';
            } else {
                document.getElementById('loginOverlay').style.display = 'flex';
            }
        } catch(e){}
    }

    async function doLogin() {
        const pin = document.getElementById('pinInput').value;
        const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({pin: pin})
        });
        if (res.ok) {
            document.getElementById('loginOverlay').style.display = 'none';
            fetchStatus();
        } else {
            document.getElementById('loginErr').innerText = 'رمز عبور نامعتبر است!';
        }
    }

    function renderChart(history) {
        if (!history || history.length < 2) return;
        const width = chartCanvas.clientWidth;
        const height = chartCanvas.clientHeight;
        chartCanvas.width = width;
        chartCanvas.height = height;

        const prices = history.map(h => h.price);
        const minP = Math.min(...prices) * 0.9995;
        const maxP = Math.max(...prices) * 1.0005;

        ctx.clearRect(0, 0, width, height);

        // Grid
        ctx.strokeStyle = "rgba(255, 255, 255, 0.05)";
        ctx.lineWidth = 1;
        for (let i = 1; i <= 4; i++) {
            let y = (height / 5) * i;
            ctx.beginPath();
            ctx.moveTo(0, y);
            ctx.lineTo(width, y);
            ctx.stroke();
        }

        // Line
        ctx.beginPath();
        history.forEach((pt, i) => {
            let x = (i / (history.length - 1)) * width;
            let y = height - ((pt.price - minP) / (maxP - minP)) * height;
            if (i === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
        });

        let grad = ctx.createLinearGradient(0, 0, 0, height);
        grad.addColorStop(0, "rgba(59, 130, 246, 0.35)");
        grad.addColorStop(1, "rgba(59, 130, 246, 0.0)");
        ctx.strokeStyle = "#38bdf8";
        ctx.lineWidth = 2.5;
        ctx.stroke();

        ctx.lineTo(width, height);
        ctx.lineTo(0, height);
        ctx.fillStyle = grad;
        ctx.fill();
    }

    async function fetchStatus() {
        try {
            const res = await fetch('/api/status');
            const data = await res.json();

            // Status Badge
            const dot = document.getElementById('statusDot');
            const stText = document.getElementById('statusText');
            if (data.bot_status === "RUNNING") {
                dot.className = "status-dot dot-running";
                stText.innerText = "RUNNING (" + data.mode + ")";
            } else {
                dot.className = "status-dot dot-stopped";
                stText.innerText = data.bot_status;
            }

            document.getElementById('exchBadge').innerText = data.exchange;
            document.getElementById('signalBadge').innerText = data.last_signal;
            document.getElementById('metricBalance').innerText = data.balance_usdt.toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('metricEquity').innerText = data.equity.toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('metricVault').innerText = data.vault_balance.toLocaleString('en-US', {minimumFractionDigits: 2});
            document.getElementById('metricWithdrawn').innerText = data.total_withdrawn.toLocaleString('en-US', {minimumFractionDigits: 2});
            
            const pnlEl = document.getElementById('metricPnL');
            pnlEl.innerText = (data.total_pnl >= 0 ? "+" : "") + data.total_pnl.toFixed(2) + " USDT";
            pnlEl.style.color = data.total_pnl >= 0 ? "var(--accent-green)" : "var(--accent-red)";
            
            document.getElementById('metricWinRate').innerText = data.win_rate + "% (" + data.total_trades + " T)";
            document.getElementById('livePrice').innerText = "$" + data.current_price.toLocaleString('en-US', {minimumFractionDigits: 2});

            // Table
            const tbody = document.getElementById('tradesBody');
            let rows = "";
            for (const [sym, pos] of Object.entries(data.positions)) {
                rows += `<tr style="background: rgba(59, 130, 246, 0.12);">
                    <td style="font-weight:700;">${sym} (${pos.leverage || 1}x)</td>
                    <td style="color:#60a5fa;">${pos.side}</td>
                    <td>$${pos.entry_price.toFixed(2)}</td>
                    <td>-</td>
                    <td class="${pos.unrealized_pnl >= 0 ? 'pnl-pos' : 'pnl-neg'}">${pos.unrealized_pnl >= 0 ? '+' : ''}${pos.unrealized_pnl} (${pos.pnl_pct}%)</td>
                    <td>${pos.time}</td>
                </tr>`;
            }
            data.trades.forEach(tr => {
                rows += `<tr>
                    <td>${tr.symbol}</td>
                    <td>${tr.side}</td>
                    <td>$${tr.entry.toFixed(2)}</td>
                    <td>$${tr.exit.toFixed(2)}</td>
                    <td class="${tr.pnl >= 0 ? 'pnl-pos' : 'pnl-neg'}">${tr.pnl >= 0 ? '+' : ''}${tr.pnl} (${tr.pnl_pct}%)</td>
                    <td>${tr.time}</td>
                </tr>`;
            });
            tbody.innerHTML = rows || `<tr><td colspan="6" style="text-align: center; color: var(--text-muted);">معامله‌ای انجام نشده</td></tr>`;

            // Logs
            const logsBox = document.getElementById('logsBox');
            logsBox.innerHTML = data.logs.map(l => `
                <div class="log-item">
                    <span class="log-time">${l.time}</span>
                    <span class="log-lvl lvl-${l.level.toLowerCase()}">${l.level}</span>
                    <span>${l.msg}</span>
                </div>
            `).join('');

            // Chart
            renderChart(data.chart);
        } catch (e) {
            console.error(e);
        }
    }

    async function startBot() { await fetch('/api/bot/start', {method: 'POST'}); fetchStatus(); }
    async function stopBot() { await fetch('/api/bot/stop', {method: 'POST'}); fetchStatus(); }
    async function panicKill() { await fetch('/api/trade/panic', {method: 'POST'}); fetchStatus(); }
    async function setMode(mode) {
        await fetch('/api/bot/set_mode', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({mode: mode})
        });
        document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
        event.target.classList.add('active');
        fetchStatus();
    }
    async function marketOrder(side) {
        await fetch('/api/trade/market', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({symbol: "BTC/USDT", side: side})
        });
        fetchStatus();
    }
    async function updateConfig() {
        const exch = document.getElementById('selectExchange').value;
        const lev = parseInt(document.getElementById('selectLeverage').value);
        await fetch('/api/bot/config', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({exchange: exch, leverage: lev})
        });
        fetchStatus();
    }
    async function doDeposit() {
        const amt = parseFloat(document.getElementById('depositAmt').value);
        if (amt > 0) {
            await fetch('/api/wallet/deposit', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({amount: amt})
            });
            fetchStatus();
        }
    }
    async function doWithdraw() {
        const amt = parseFloat(document.getElementById('withdrawAmt').value);
        const addr = document.getElementById('withdrawAddr').value;
        if (amt > 0 && addr) {
            await fetch('/api/wallet/withdraw', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({amount: amt, address: addr})
            });
            fetchStatus();
        }
    }

    checkAuth();
    setInterval(fetchStatus, 1500);
    fetchStatus();
</script>
</body>
</html>
"""
