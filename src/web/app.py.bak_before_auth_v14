@app.get("/api/telemetry")
async def get_telemetry():
    """Returns live telemetry payload formatted for dashboard.html & index.html"""
    # Dynamic price simulation jitter for charts
    import random
    jitter = random.uniform(-15.0, 15.0)
    BOT_STATE["btc_price"] = round(BOT_STATE["btc_price"] + jitter, 2)

    pos = BOT_STATE["position"]
    if pos and pos.get("side") != "FLAT":
        pos["pnl"] = round((BOT_STATE["btc_price"] - pos["entry_price"]) * pos["amount"], 2)

    payload = {
        "status": BOT_STATE["status"],
        "mode": BOT_STATE["mode"],
        "autopilot": BOT_STATE["autopilot"],
        "btc_price": f"{BOT_STATE['btc_price']:,.2f}",
        "current_price": BOT_STATE["btc_price"],
        "total_equity": round(BOT_STATE["total_equity"] + (pos.get("pnl", 0) if pos else 0), 2),
        "equity": round(BOT_STATE["total_equity"], 2),
        "reserve_usdt": BOT_STATE["reserve_usdt"],
        "safe_profit": BOT_STATE["reserve_usdt"],
        "win_rate": BOT_STATE["win_rate"],
        "total_profit_usdt": BOT_STATE["total_profit_usdt"],
        "rsi": BOT_STATE["rsi"],
        "trend": BOT_STATE["trend"],
        "position": pos,
        "active_position": pos,
        "recent_trades": BOT_STATE["recent_trades"],
        "logs": BOT_STATE["logs"],
        "timestamp": time.time()
    }
    return JSONResponse(content=payload)

@app.post("/api/action")
async def handle_action(payload: Dict[str, Any] = Body(...)):
    """Handles manual buttons from dashboard UI (BUY, SELL, STOP, START, etc.)"""
    action = payload.get("action", "").upper()
    amount = float(payload.get("amount", 0.02))

    if action in ["BUY", "LONG"]:
        BOT_STATE["position"] = {
            "side": "LONG",
            "amount": amount,
            "entry_price": BOT_STATE["btc_price"],
            "pnl": 0.0,
            "pnl_pct": 0.0,
            "tp": round(BOT_STATE["btc_price"] * 1.02, 2),
            "sl": round(BOT_STATE["btc_price"] * 0.98, 2)
        }
        add_log(f"🟢 Manual Market BUY: {amount} BTC @ ${BOT_STATE['btc_price']:,.2f}")
        return {"success": True, "message": f"Bought {amount} BTC (Paper)"}

    elif action in ["SELL", "SHORT"]:
        BOT_STATE["position"] = {
            "side": "SHORT",
            "amount": amount,
            "entry_price": BOT_STATE["btc_price"],
            "pnl": 0.0,
            "pnl_pct": 0.0,
            "tp": round(BOT_STATE["btc_price"] * 0.98, 2),
            "sl": round(BOT_STATE["btc_price"] * 1.02, 2)
        }
        add_log(f"🔴 Manual Market SELL: {amount} BTC @ ${BOT_STATE['btc_price']:,.2f}")
        return {"success": True, "message": f"Sold {amount} BTC (Paper)"}

    elif action in ["CLOSE", "CLOSE_POSITION"]:
        pos = BOT_STATE["position"]
        if pos and pos.get("side") != "FLAT":
            pnl = pos.get("pnl", 0.0)
            BOT_STATE["total_equity"] += pnl
            BOT_STATE["total_profit_usdt"] += pnl
            add_log(f"⚪ Closed Position {pos['side']} | Realized PnL: ${pnl:+.2f}")
            BOT_STATE["recent_trades"].insert(0, {
                "time": time.strftime("%H:%M:%S"),
                "time_str": time.strftime("%H:%M:%S"),
                "action": "CLOSE",
                "side": pos["side"],
                "amount": pos["amount"],
                "entry_price": pos["entry_price"],
                "exit_price": BOT_STATE["btc_price"],
                "pnl": pnl
            })
            BOT_STATE["position"] = {"side": "FLAT", "amount": 0, "entry_price": 0, "pnl": 0, "pnl_pct": 0, "tp": 0, "sl": 0}
            return {"success": True, "message": f"Position closed with PnL ${pnl:+.2f}"}
        return {"success": False, "message": "No active position to close"}

    elif action in ["START", "RESUME"]:
        BOT_STATE["status"] = "RUNNING"
        add_log("▶ Bot Trading Engine Resumed.")
        return {"success": True, "status": "RUNNING"}

    elif action in ["STOP", "PAUSE"]:
        BOT_STATE["status"] = "PAUSED"
        add_log("⏸ Bot Trading Engine Paused.")
        return {"success": True, "status": "PAUSED"}

    elif action == "TOGGLE_AUTOPILOT":
        BOT_STATE["autopilot"] = not BOT_STATE["autopilot"]
        state_str = "ENABLED" if BOT_STATE["autopilot"] else "DISABLED"
        add_log(f"🤖 Auto-Pilot Strategy mode {state_str}.")
        return {"success": True, "autopilot": BOT_STATE["autopilot"]}

    return {"success": False, "message": f"Unknown action: {action}"}

@app.post("/api/order/close")
async def close_order():
    return await handle_action({"action": "CLOSE"})

@app.post("/api/panic")
async def panic_button():
    add_log("🚨 PANIC BUTTON TRIGGERED! Closing positions & pausing bot...")
    await handle_action({"action": "CLOSE"})
    BOT_STATE["status"] = "STOPPED"
    BOT_STATE["autopilot"] = False
    return {"success": True, "message": "Panic executed: All positions closed and bot stopped."}

