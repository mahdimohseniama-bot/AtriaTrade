<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AtriaTrade Pro</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
        body { background-color: #0b0f19; color: #f3f4f6; padding: 12px; }
        .header { display: flex; justify-content: space-between; align-items: center; background: #151c2e; padding: 12px; border-radius: 12px; margin-bottom: 12px; border: 1px solid #1f293d; }
        .header h1 { font-size: 1rem; color: #38bdf8; font-weight: bold; }
        .header-btns { display: flex; gap: 8px; }
        .btn { border: none; border-radius: 8px; font-size: 0.8rem; font-weight: 600; cursor: pointer; padding: 8px 12px; transition: 0.2s; }
        .btn:active { transform: scale(0.96); }
        .btn-panic { background: #ef4444; color: white; }
        .btn-auto-on { background: #10b981; color: white; }
        .btn-auto-off { background: #4b5563; color: white; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
        .card { background: #151c2e; border: 1px solid #1f293d; border-radius: 12px; padding: 12px; }
        .card-title { font-size: 0.75rem; color: #9ca3af; margin-bottom: 4px; }
        .card-value { font-size: 1.1rem; font-weight: bold; }
        .chart-box { background: #151c2e; border: 1px solid #1f293d; border-radius: 12px; padding: 8px; margin-bottom: 12px; height: 160px; }
        canvas { width: 100%; height: 100%; }
        .pos-card { background: #151c2e; border: 1px solid #1f293d; border-radius: 12px; padding: 12px; margin-bottom: 12px; }
        .action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
        .btn-buy { background: #10b981; color: white; padding: 12px; font-size: 0.85rem; }
        .btn-sell { background: #ef4444; color: white; padding: 12px; font-size: 0.85rem; }
        .btn-close { background: #f59e0b; color: #111827; grid-column: span 2; padding: 12px; font-weight: bold; font-size: 0.9rem; margin-top: 6px; }
        .table-card { background: #151c2e; border: 1px solid #1f293d; border-radius: 12px; padding: 12px; margin-bottom: 12px; }
        table { width: 100%; border-collapse: collapse; font-size: 0.75rem; text-align: right; }
        th, td { padding: 6px 4px; border-bottom: 1px solid #1f293d; }
        th { color: #9ca3af; }
        .logs-card { background: #070a10; border: 1px solid #1f293d; border-radius: 12px; padding: 10px; font-family: monospace; font-size: 0.75rem; color: #10b981; height: 110px; overflow-y: auto; }
        .badge { padding: 2px 6px; border-radius: 4px; font-weight: bold; font-size: 0.7rem; }
        .badge-buy { background: #064e3b; color: #34d399; }
        .badge-sell { background: #7f1d1d; color: #f87171; }
    </style>
</head>
<body>
    <div class="header">
        <h1><span>⚡</span> ATRATRADE PRO</h1>
        <div class="header-btns">
            <button class="btn btn-panic" onclick="callApi('/api/panic')">PANIC</button>
            <button id="btnAuto" class="btn btn-auto-on" onclick="callApi('/api/autopilot/toggle')">اتوپایلوت: فعال</button>
        </div>
    </div>

    <div class="grid">
        <div class="card">
            <div class="card-title">قیمت BTC/USDT</div>
            <div class="card-value" id="priceDisplay" style="color:#10b981;">---</div>
        </div>
        <div class="card">
            <div class="card-title">کل سرمایه (Equity)</div>
            <div class="card-value" id="equityDisplay" style="color:#38bdf8;">$10,000.00</div>
        </div>
        <div class="card">
            <div class="card-title">صندوق امن سود (Safe Vault)</div>
            <div class="card-value" id="vaultDisplay" style="color:#facc15;">$0.00</div>
        </div>
        <div class="card">
            <div class="card-title">RSI (14) / روند</div>
            <div class="card-value" id="rsiDisplay">-- / --</div>
        </div>
    </div>

    <div class="chart-box">
        <canvas id="simpleChart"></canvas>
    </div>

    <div class="pos-card">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <strong>پوزیشن فعال:</strong>
            <span id="posStatus" style="color:#9ca3af;">بدون معامله باز</span>
        </div>
        <div id="posDetails" style="font-size:0.85rem; color:#d1d5db; display:none; margin-top:8px; border-top:1px dashed #374151; padding-top:8px;">
            <div style="display:flex; justify-content:space-between;">
                <span>قیمت ورود: <b id="posEntry">$0</b></span>
                <span>حجم: <b>0.02 BTC</b></span>
            </div>
            <div style="margin-top:6px; font-weight:bold; font-size:1rem; display:flex; justify-content:space-between;">
                <span>سود/زیان لحظه‌ای:</span>
                <span id="posPnL">$0.00 (0.0%)</span>
            </div>
        </div>
    </div>

    <div class="action-grid">
        <button class="btn btn-buy" onclick="sendOrder('BUY')">📈 خرید دستی (0.02 BTC)</button>
        <button class="btn btn-sell" onclick="sendOrder('SELL')">📉 فروش دستی (0.02 BTC)</button>
        <button class="btn btn-close" id="btnClosePos" style="display:none;" onclick="callApi('/api/order/close')">⚡ بستن پوزیشن و تسویه سود</button>
    </div>

    <div class="table-card">
        <div style="display:flex; justify-content:space-between; margin-bottom:8px; font-size:0.85rem; font-weight:bold; color:#38bdf8;">
            <span>📑 تاریخچه معاملات (SQLite)</span>
            <a href="/api/export/csv" style="color:#38bdf8; text-decoration:none;">📥 دانلود CSV</a>
        </div>
        <table>
            <thead>
                <tr>
                    <th>زمان</th>
                    <th>نوع</th>
                    <th>ورود</th>
                    <th>خروج</th>
                    <th>سود/زیان</th>
                </tr>
            </thead>
            <tbody id="tradeTableBody">
                <tr><td colspan="5" style="text-align:center; color:#6b7280;">هنوز معامله ای ثبت نشده است</td></tr>
            </tbody>
        </table>
    </div>

    <div class="logs-card" id="logBox">در حال بارگذاری لاگ‌ها...</div>

    <script>
        function drawChart(prices) {
            const canvas = document.getElementById("simpleChart");
            if (!canvas || !prices || prices.length < 2) return;
            const w = canvas.width = canvas.parentElement.clientWidth;
            const h = canvas.height = canvas.parentElement.clientHeight;
            const ctx = canvas.getContext("2d");
            ctx.clearRect(0, 0, w, h);

            const min = Math.min(...prices);
            const max = Math.max(...prices);
            const range = (max - min) || 1;

            ctx.strokeStyle = "#10b981";
            ctx.lineWidth = 2.5;
            ctx.beginPath();
            prices.forEach((p, i) => {
                const x = (i / (prices.length - 1)) * (w - 30) + 15;
                const y = h - 20 - ((p - min) / range) * (h - 40);
                if (i === 0) ctx.moveTo(x, y);
                else ctx.lineTo(x, y);
            });
            ctx.stroke();

            ctx.fillStyle = "#9ca3af";
            ctx.font = "10px sans-serif";
            ctx.fillText("Max: $" + max.toFixed(0), 10, 14);
            ctx.fillText("Min: $" + min.toFixed(0), 10, h - 5);
        }

        async function updateData() {
            try {
                const res = await fetch("/api/telemetry?t=" + Date.now());
                if (!res.ok) return;
                const d = await res.json();

                document.getElementById("priceDisplay").innerText = "$" + Number(d.current_price).toLocaleString();
                document.getElementById("equityDisplay").innerText = "$" + Number(d.equity).toLocaleString(undefined, {minimumFractionDigits:2});
                document.getElementById("vaultDisplay").innerText = "$" + Number(d.safe_profit).toLocaleString(undefined, {minimumFractionDigits:2});
                document.getElementById("rsiDisplay").innerText = d.rsi + " / " + d.trend;

                const btnAuto = document.getElementById("btnAuto");
                btnAuto.className = d.autopilot ? "btn btn-auto-on" : "btn btn-auto-off";
                btnAuto.innerText = d.autopilot ? "اتوپایلوت: فعال" : "اتوپایلوت: غیرفعال";

                drawChart(d.price_history);

                const pos = d.active_position;
                const posDetails = document.getElementById("posDetails");
                const posStatus = document.getElementById("posStatus");
                const btnClose = document.getElementById("btnClosePos");
                
                if (pos) {
                    posStatus.innerHTML = '<span class="badge ' + (pos.side === 'BUY' ? 'badge-buy' : 'badge-sell') + '">' + pos.side + '</span>';
                    document.getElementById("posEntry").innerText = "$" + Number(pos.entry_price).toLocaleString();
                    const pnlEl = document.getElementById("posPnL");
                    pnlEl.innerText = (pos.pnl >= 0 ? "+" : "") + "$" + pos.pnl + " (" + (pos.pnl_pct >= 0 ? "+" : "") + pos.pnl_pct + "%)";
                    pnlEl.style.color = pos.pnl >= 0 ? "#34d399" : "#f87171";
                    posDetails.style.display = "block";
                    btnClose.style.display = "block";
                } else {
                    posStatus.innerText = "بدون معامله باز";
                    posDetails.style.display = "none";
                    btnClose.style.display = "none";
                }

                if (d.recent_trades && d.recent_trades.length > 0) {
                    document.getElementById("tradeTableBody").innerHTML = d.recent_trades.map(t => 
                        `<tr><td>${t.time_str}</td><td><span class="badge ${t.side === 'BUY' ? 'badge-buy' : 'badge-sell'}">${t.side}</span></td><td>$${Number(t.entry_price).toLocaleString()}</td><td>$${Number(t.exit_price).toLocaleString()}</td><td style="color:${t.pnl>=0?'#34d399':'#f87171'};font-weight:bold;">${t.pnl>=0?'+':''}$${t.pnl}</td></tr>`
                    ).join("");
                }

                if (d.logs && d.logs.length > 0) {
                    const logBox = document.getElementById("logBox");
                    logBox.innerHTML = d.logs.join("<br>");
                    logBox.scrollTop = logBox.scrollHeight;
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function sendOrder(side) {
            await fetch("/api/order/manual", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ side: side, amount: 0.02 })
            });
            updateData();
        }

        async function callApi(url) {
            await fetch(url, { method: "POST" });
            updateData();
        }

        setInterval(updateData, 1500);
        updateData();
    </script>
</body>
</html>
