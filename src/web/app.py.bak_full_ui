from fastapi import FastAPI, Request
from fastapi.responses import HTMLResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates
import os
import time

app = FastAPI(title="AtriaTrade Pro Dashboard")

# Setup templates and static directories if they exist
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
TEMPLATES_DIR = os.path.join(BASE_DIR, "templates")
STATIC_DIR = os.path.join(BASE_DIR, "static")

if os.path.exists(STATIC_DIR):
    app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")

templates = Jinja2Templates(directory=TEMPLATES_DIR if os.path.exists(TEMPLATES_DIR) else BASE_DIR)

# Mock / Simulated state for Paper Trading Dashboard
state = {
    "bot_status": "active",
    "mode": "paper_trading",
    "balance_usdt": 10000.0,
    "equity": 10250.0,
    "pnl_usd": 250.0,
    "pnl_pct": 2.5,
    "vault_balance": 50.0,
    "safe_vault": 50.0,
    "vault_usdt": 50.0,
    "btc_price": 64250.0,
    "last_price": 64250.0,
    "active_position": {
        "symbol": "BTC/USDT",
        "side": "BUY",
        "amount": 0.05,
        "entry_price": 63800.0,
        "current_price": 64250.0,
        "unrealized_pnl": 22.5,
        "pnl_pct": 0.7
    },
    "trades": [
        {
            "id": 1,
