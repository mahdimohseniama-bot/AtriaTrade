)
async def get_public_status_endpoint(request: Request): # CORRECTED: Removed `= Request(...)`
    """
    Public endpoint to check if the API service is running.
    """
    return PublicStatusResponse(
        system="AtriaTrade API",
        online=True,
        timestamp=time.time()
    )

@app.get(
    "/api/dashboard/summary",
    response_model=DashboardSummaryResponse,
    summary="Get Authenticated Dashboard Summary",
    tags=["Dashboard API"],
    dependencies=[Depends(api_key_header)],
    description="Retrieves detailed bot status, user information, and trading data. Requires a valid authentication token."
)
async def get_dashboard_summary_endpoint(
    token: str = Depends(api_key_header),
    request: Request # CORRECTED: Removed `= Request(...)`
):
    """
    Fetches the main dashboard summary data. Requires authentication via `X-Auth-Token` header.
    Returns user details and bot operational state if the token is valid.
    """
    client_ip = get_client_ip(request)
    result = await dashboard_server.get_dashboard_summary(token=token, client_ip=client_ip)

    if not result.get("success", False):
        raise HTTPException(
            status_code=401,
            detail={"message": result.get("error", "Authentication failed. Invalid or expired token.")}
        )

    bot_data = None
    if "data" in result and result["data"]:
        try:
            bot_data = BotStateData(**result["data"])
        except Exception as e:
            print(f"Error parsing BotStateData: {e}")
            raise HTTPException(
                status_code=500,
                detail={"message": "Internal server error processing dashboard data."}
            )

    return DashboardSummaryResponse(
        success=True,
        user=result.get("user"),
        role=result.get("role"),
        data=bot_data
    )

@app.put(
    "/api/bot/state",
    response_model=UpdateBotStateResponse,
    summary="Update Bot State Parameter (Admin Only)",
    tags=["Admin Control"],
    dependencies=[Depends(api_key_header)],
    description="Allows authenticated administrators to modify specific bot state parameters dynamically. Requires 'admin' role."
)
async def update_bot_state_endpoint(
    key: str,
    value: Any,
    token: str = Depends(api_key_header),
    request: Request # CORRECTED: Removed `= Request(...)`
):
    """
    Endpoint to update a specific parameter in the bot's state.
    Requires authentication and the user must have admin privileges.
    Example Usage: PUT /api/bot/state?key=mode&value="LIVE_TRADING"
    """
    client_ip = get_client_ip(request)
    result = await dashboard_server.update_bot_state(key=key, value=value, token=token, client_ip=client_ip)

    if not result.get("success", False):
        error_message = result.get("error", "Unknown error during state update.")
        status_code = 403

        if "Unauthorized" in error_message or "Invalid token" in error_message:
            status_code = 401
        elif "Not an administrator" in error_message or "permission denied" in error_message:
            status_code = 403
        else:
            status_code = 500

        raise HTTPException(status_code=status_code, detail={"message": error_message})

    return UpdateBotStateResponse(
        success=True,
        updated_key=result.get("updated_key"),
        new_value=result.get("new_value")
    )

