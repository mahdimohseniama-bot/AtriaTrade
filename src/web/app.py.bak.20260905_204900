# --- Utility Functions ---
def get_client_ip(request: Request) -> str:
    """
    Retrieves the client's IP address from the request.
    Handles common proxy headers like X-Forwarded-For for accurate IP logging.
    """
    if request.client and request.client.host:
        return request.client.host
    
    forwarded_for = request.headers.get("X-Forwarded-For")
    if forwarded_for:
        return forwarded_for.split(",")[0].strip()
        
    return "127.0.0.1"


# --- Pydantic Models for Request/Response Data Validation ---

class PublicStatusResponse(BaseModel):
    """Response model for the public status endpoint."""
    system: str = Field(..., description="Name of the system component (e.g., 'AtriaTrade API').")
    online: bool = Field(..., description="Indicates if the system component is operational.")
    timestamp: float = Field(..., description="Unix timestamp of when the status was checked.")

class BotStateData(BaseModel):
    """Detailed data model for the bot's current operational state."""
    status: str = Field(..., description="Current status of the bot (e.g., RUNNING, STOPPED, PAUSED, ERROR).")
    mode: str = Field(..., description="Trading mode (e.g., PAPER_TRADING, TESTNET, LIVE_TRADING).")
    active_positions: int = Field(..., description="Number of currently active trading positions.")
    total_balance_usdt: float = Field(..., description="Total account balance denominated in USDT.")
    profit_reserved: float = Field(..., description="Amount of profit currently reserved or set aside in USDT.")

class DashboardSummaryResponse(BaseModel):
    """Comprehensive response model for the authenticated dashboard summary."""
    success: bool = Field(..., description="Indicates if the request was processed successfully.")
    user: Optional[str] = Field(None, description="Username of the authenticated user.")
    role: Optional[str] = Field(None, description="Role assigned to the user (e.g., 'admin', 'trader', 'viewer').")
    data: Optional[BotStateData] = Field(None, description="Detailed bot state information, included only on success.")
    error: Optional[str] = Field(None, description="Error message if the operation failed (e.g., authentication, authorization).")

class UpdateBotStateResponse(BaseModel):
    """Response model for updating bot state parameters."""
    success: bool = Field(..., description="Indicates if the state update was successful.")
    updated_key: Optional[str] = Field(None, description="The specific key that was modified.")
    new_value: Optional[Any] = Field(None, description="The new value assigned to the updated key.")
    error: Optional[str] = Field(None, description="Error message if the update failed.")

# --- API Endpoints Definition ---

@app.get(
