# -*- coding: utf-8 -*-
"""
AtriaTrade Web App
- Serves the dashboard UI
- Keeps current backend APIs
- Paper-trading safe only
"""

from __future__ import annotations

import os
import time
from typing import Any, Optional

import uvicorn
from fastapi import Depends, FastAPI, HTTPException, Request
from fastapi.responses import HTMLResponse
from fastapi.security import APIKeyHeader
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates
from pydantic import BaseModel, Field

# ---------------------------------------------------------------------
# Project imports
# ---------------------------------------------------------------------
try:
    from src.dashboard.server import DashboardServer
    from src.dashboard.auth import SecureAuthManager
except ImportError as e:
    print(f"❌ ImportError: Could not import dashboard components. {e}")
    print("   Please ensure:")
    print("   1. You are running this script from the root directory of AtriaTrade (~/AtriaTrade).")
    print("   2. The directory structure includes src/dashboard/server.py and src/dashboard/auth.py.")
    raise

# ---------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------
AUTH_TOKEN_HEADER_NAME = "X-Auth-Token"
ADMIN_TOKEN_FOR_TEST = "SET_YOUR_ADMIN_TOKEN_HERE"  # replace with a real token if needed

WEB_DIR = os.path.dirname(os.path.abspath(__file__))
TEMPLATES_DIR = os.path.join(WEB_DIR, "templates")
STATIC_DIR = os.path.join(WEB_DIR, "static")

# ---------------------------------------------------------------------
# Auth / dashboard backend
# ---------------------------------------------------------------------
auth_manager = SecureAuthManager()
dashboard_server = DashboardServer(auth_manager=auth_manager)

# ---------------------------------------------------------------------
# FastAPI app
# ---------------------------------------------------------------------
app = FastAPI(
    title="AtriaTrade Dashboard API",
    description="API for managing and monitoring the AtriaTrade bot. Paper-trading safe.",
    version="1.2.0",
)

api_key_header = APIKeyHeader(name=AUTH_TOKEN_HEADER_NAME, auto_error=True)

templates = Jinja2Templates(directory=TEMPLATES_DIR)

if os.path.isdir(STATIC_DIR):
    app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")


# ---------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------
def get_client_ip(request: Request) -> str:
    if request.client and request.client.host:
        return request.client.host

    forwarded_for = request.headers.get("X-Forwarded-For")
    if forwarded_for:
        return forwarded_for.split(",")[0].strip()

    return "127.0.0.1"


def require_auth_token(token: str) -> None:
    if token == ADMIN_TOKEN_FOR_TEST:
        return
    # If you later generate dynamic tokens with SecureAuthManager,
    # the dashboard_server layer can validate them.
    # This fallback keeps local development simple.
    raise HTTPException(
        status_code=401,
        detail={"message": "Unauthorized. Invalid or expired token."},
    )


# ---------------------------------------------------------------------
# Models
# ---------------------------------------------------------------------
class PublicStatusResponse(BaseModel):
    system: str = Field(..., description="System name")
    online: bool = Field(..., description="System online state")
    timestamp: float = Field(..., description="Unix time")


class BotStateData(BaseModel):
    status: str
    mode: str
    active_positions: int
    total_balance_usdt: float
    profit_reserved: float


class DashboardSummaryResponse(BaseModel):
    success: bool
    user: Optional[str] = None
    role: Optional[str] = None
    data: Optional[BotStateData] = None
    error: Optional[str] = None


class UpdateBotStateResponse(BaseModel):
    success: bool
    updated_key: Optional[str] = None
    new_value: Optional[Any] = None
    error: Optional[str] = None


# ---------------------------------------------------------------------
# UI routes
# ---------------------------------------------------------------------
@app.get("/", response_class=HTMLResponse)
async def root(request: Request):
    return templates.TemplateResponse(
        "dashboard.html",
        {"request": request, "page_title": "AtriaTrade Dashboard"},
    )


@app.get("/dashboard", response_class=HTMLResponse)
async def dashboard_page(request: Request):
    return templates.TemplateResponse(
        "dashboard.html",
        {"request": request, "page_title": "AtriaTrade Dashboard"},
    )


# ---------------------------------------------------------------------
# API routes
# ---------------------------------------------------------------------
@app.get(
    "/api/public/status",
    response_model=PublicStatusResponse,
    summary="Get Public System Status",
    tags=["Public Endpoints"],
)
async def get_public_status_endpoint(request: Request):
    return PublicStatusResponse(
        system="AtriaTrade API",
        online=True,
        timestamp=time.time(),
    )


@app.get(
    "/api/dashboard/summary",
    response_model=DashboardSummaryResponse,
    summary="Get Authenticated Dashboard Summary",
    tags=["Dashboard API"],
    dependencies=[Depends(api_key_header)],
)
async def get_dashboard_summary_endpoint(
    request: Request,
    token: str = Depends(api_key_header),
):
    client_ip = get_client_ip(request)

    if token != ADMIN_TOKEN_FOR_TEST:
        # Try backend validation if a real token system is available
        result = await dashboard_server.get_dashboard_summary(
            token=token,
            client_ip=client_ip,
        )
        if not result.get("success", False):
            raise HTTPException(
                status_code=401,
                detail={"message": result.get("error", "Authentication failed.")},
            )

        bot_data = None
        if result.get("data"):
            try:
                bot_data = BotStateData(**result["data"])
            except Exception as e:
                raise HTTPException(
                    status_code=500,
                    detail={"message": f"Failed to parse dashboard data: {e}"},
                )

        return DashboardSummaryResponse(
            success=True,
            user=result.get("user"),
            role=result.get("role"),
            data=bot_data,
        )

    # Local dev fallback
    return DashboardSummaryResponse(
        success=True,
        user="admin",
        role="admin",
        data=BotStateData(
            status="RUNNING",
            mode="PAPER_TRADING",
            active_positions=0,
            total_balance_usdt=0.0,
            profit_reserved=0.0,
        ),
    )


@app.put(
    "/api/bot/state",
    response_model=UpdateBotStateResponse,
    summary="Update Bot State Parameter",
    tags=["Admin Control"],
    dependencies=[Depends(api_key_header)],
)
async def update_bot_state_endpoint(
    request: Request,
    key: str,
    value: Any,
    token: str = Depends(api_key_header),
):
    if token != ADMIN_TOKEN_FOR_TEST:
        client_ip = get_client_ip(request)
        result = await dashboard_server.update_bot_state(
            key=key,
            value=value,
            token=token,
            client_ip=client_ip,
        )
        if not result.get("success", False):
            raise HTTPException(
                status_code=403,
                detail={"message": result.get("error", "Unknown error during state update.")},
            )
        return UpdateBotStateResponse(
            success=True,
            updated_key=result.get("updated_key"),
            new_value=result.get("new_value"),
        )

    # Safe local fallback: do not change live trading state
    return UpdateBotStateResponse(
        success=True,
        updated_key=key,
        new_value=value,
    )


# ---------------------------------------------------------------------
# Run server
# ---------------------------------------------------------------------
if __name__ == "__main__":
    HOST = "127.0.0.1"
    PORT = 8080

    print("\n" + "=" * 60)
    print("🚀 Starting AtriaTrade Dashboard API Server...")
