    print(f"   Docs: http://{HOST}:{PORT}/docs")
    print(f"   ReDoc: http://{HOST}:{PORT}/redoc")
    print("=" * 60 + "\n")

    uvicorn.run(
        "src.web.app:app",
        host=HOST,
        port=PORT,
        reload=True,
    )
