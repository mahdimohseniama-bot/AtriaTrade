import os
import sys
import asyncio
import logging
from typing import Dict, Any, Optional
from fastapi import FastAPI, HTTPException
from fastapi.responses import HTMLResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel

# هسته‌های اصلی سیستم AtriaTrade
from src.core.trading_engine import TradingEngine
from src.core.portfolio_manager import PortfolioManager
from src.core.risk_manager import RiskManager
from src.core.profit_reserve import ProfitReserveManager
from src.core.order_executor import OrderExecutor

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger("AtriaTradeWeb")

app = FastAPI(title="AtriaTrade Paper Trading Dashboard")

# مقداردهی ماژول‌های هسته در حالت Paper Trading
initial_balance = 10000.0  # موجودی مجازی شبیه‌سازی
portfolio_mgr = PortfolioManager(initial_balance=initial_balance)
risk_mgr = RiskManager()
profit_reserve_mgr = ProfitReserveManager()
order_exec = OrderExecutor(risk_manager=risk_mgr, portfolio=portfolio_mgr)

engine = TradingEngine(
    portfolio=portfolio_mgr,
    risk_manager=risk_mgr,
    order_executor=order_exec,
    profit_reserve_manager=profit_reserve_mgr
)

# متغیرهای کمکی برای وضعیت داشبورد
is_autopilot_active = False
system_logs = ["سیستم با موفقیت در حالت Paper Trading راه‌اندازی شد."]

class ManualOrderRequest(BaseModel):
    symbol: str = "BTC/USDT"
    side: str
    amount: float = 0.01
    price: Optional[float] = None

@app.get("/", response_class=HTMLResponse)
async def serve_dashboard():
    index_path = os.path.join(os.path.dirname(__file__), "index.html")
    if os.path.exists(index_path):
        with open(index_path, "r", encoding="utf-8") as f:
            return HTMLResponse(content=f.read())
    return HTMLResponse("<h1>داشبورد AtriaTrade: فایل index.html یافت نشد!</h1>", status_code=404)

@app.get("/api/status")
async def get_status():
    summary = portfolio_mgr.get_summary() if hasattr(portfolio_mgr, "get_summary") else {}
    current_balance = portfolio_mgr.get_balance() if hasattr(portfolio_mgr, "get_balance") else initial_balance
    
    positions = []
    if hasattr(portfolio_mgr, "positions"):
        for sym, pos in portfolio_mgr.positions.items():
            if isinstance(pos, dict):
                positions.append(pos)
            elif hasattr(pos, "__dict__"):
                positions.append(pos.__dict__)
            elif hasattr(pos, "to_dict"):
                positions.append(pos.to_dict())

    return {
        "status": "online",
        "mode": "PAPER_TRADING",
        "autopilot": is_autopilot_active,
        "balance": current_balance,
        "equity": summary.get("equity", current_balance),
        "total_profit": summary.get("total_profit", 0.0),
        "reserve_profit": profit_reserve_mgr.get_total_reserved() if hasattr(profit_reserve_mgr, "get_total_reserved") else 0.0,
        "positions": positions,
        "logs": system_logs[-20:]
    }

@app.post("/api/toggle_autopilot")
async def toggle_autopilot():
    global is_autopilot_active
    is_autopilot_active = not is_autopilot_active
    status_str = "فعال" if is_autopilot_active else "متوقف"
    log_msg = f"سیستم اتوپایلوت {status_str} شد."
    system_logs.append(log_msg)
    logger.info(log_msg)
    return {"autopilot": is_autopilot_active, "message": log_msg}

@app.post("/api/order/manual")
async def place_manual_order(req: ManualOrderRequest):
    try:
        side_lower = req.side.lower()
        log_msg = f"ثبت سفارش دستی {req.side.upper()} برای {req.symbol} با حجم {req.amount}"
        system_logs.append(log_msg)
        
        # پردازش از طریق هسته و OrderExecutor
        if hasattr(order_exec, "execute_order"):
            res = order_exec.execute_order(
                symbol=req.symbol,
                side=side_lower,
                amount=req.amount,
                price=req.price
            )
        elif hasattr(engine, "place_order"):
            res = engine.place_order(
                symbol=req.symbol,
                side=side_lower,
                amount=req.amount,
                price=req.price
            )
        else:
            res = {"status": "FILLED", "symbol": req.symbol, "side": req.side, "amount": req.amount}
            
        system_logs.append(f"سفارش با موفقیت اجرا شد: {res}")
        return {"success": True, "result": res}
    except Exception as e:
        err_msg = f"خطا در ثبت سفارش دستی: {str(e)}"
        system_logs.append(err_msg)
        logger.error(err_msg)
        raise HTTPException(status_code=400, detail=err_msg)

@app.post("/api/panic")
async def panic_close_all():
    global is_autopilot_active
    is_autopilot_active = False
    try:
        if hasattr(portfolio_mgr, "close_all_positions"):
            portfolio_mgr.close_all_positions()
        log_msg = "دستور PANIC اجرا شد: تمامی پوزیشن‌ها بسته و اتوپایلوت خاموش شد."
        system_logs.append(log_msg)
        return {"success": True, "message": log_msg}
    except Exception as e:
        err_msg = f"خطا در اجرای PANIC: {str(e)}"
        system_logs.append(err_msg)
        raise HTTPException(status_code=500, detail=err_msg)
