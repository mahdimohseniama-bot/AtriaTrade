<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AtriaTrade Pro Auto-Pilot</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; }
        .glass-panel {
            background: rgba(17, 24, 39, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
    </style>
</head>
<body class="bg-gray-950 text-gray-100 min-h-screen p-3 sm:p-5 flex flex-col gap-4">

    <!-- Header & Quick Controls -->
    <header class="flex justify-between items-center bg-gray-900 border border-gray-800 p-3 rounded-2xl shadow-lg">
        <div class="flex items-center gap-2">
            <span class="inline-block w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
            <h1 class="text-sm sm:text-base font-bold tracking-wide">ATRIATRADE AUTO-PILOT</h1>
        </div>
        <div class="flex items-center gap-2">
            <button id="auto-btn" onclick="triggerAction('toggle_auto')" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-emerald-600 text-white hover:bg-emerald-500 transition">اتوپایلوت: فعال</button>
            <button onclick="triggerAction('panic')" class="px-3 py-1.5 text-xs font-bold rounded-xl bg-rose-600 text-white hover:bg-rose-500 transition">PANIC 🚨</button>
        </div>
    </header>

    <!-- Metrics Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <div class="glass-panel p-3.5 rounded-2xl border-cyan-500/30">
            <div class="text-[11px] text-gray-400 font-medium">قیمت BTC/USDT</div>
            <div id="btc-price" class="text-base sm:text-lg font-black text-cyan-400 mt-1">$0.00</div>
        </div>
        <div class="glass-panel p-3.5 rounded-2xl border-blue-500/30">
            <div class="text-[11px] text-gray-400 font-medium">کل سرمایه (Equity)</div>
            <div id="total-equity" class="text-base sm:text-lg font-black text-blue-400 mt-1">$0.00</div>
        </div>
        <div class="glass-panel p-3.5 rounded-2xl border-amber-500/30">
            <div class="text-[11px] text-gray-400 font-medium">صندوق امن سود</div>
            <div id="reserve-vault" class="text-base sm:text-lg font-black text-amber-400 mt-1">$0.00</div>
        </div>
        <div class="glass-panel p-3.5 rounded-2xl border-purple-500/30">
            <div class="text-[11px] text-gray-400 font-medium">نرخ برد / سود کل</div>
            <div id="win-rate-stat" class="text-base sm:text-lg font-black text-purple-400 mt-1">0% (+$0.00)</div>
        </div>
    </div>

    <!-- Live Chart Panel -->
    <div class="glass-panel p-3.5 rounded-2xl">
        <div class="flex justify-between items-center mb-2">
            <div class="text-xs font-bold text-gray-300">📈 نوسانات زنده قیمت BTC</div>
            <span class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded-full font-semibold">LIVE</span>
        </div>
        <div class="h-44 w-full">
            <canvas id="priceChart"></canvas>
        </div>
    </div>

    <!-- Indicators & Active Position -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="glass-panel p-3.5 rounded-2xl flex flex-col justify-between">
            <div class="text-xs font-bold text-gray-400">تحلیل تکنیکال</div>
            <div class="flex justify-between items-center mt-2">
                <span class="text-xs text-gray-300">شاخص RSI (14):</span>
                <span id="rsi-val" class="text-sm font-bold text-amber-400">--</span>
            </div>
            <div class="flex justify-between items-center mt-1">
                <span class="text-xs text-gray-300">روند استراتژی:</span>
                <span id="trend-val" class="text-xs font-bold text-emerald-400">--</span>
            </div>
        </div>
        <div class="glass-panel p-3.5 rounded-2xl flex flex-col justify-between border-indigo-500/30">
            <div class="text-xs font-bold text-gray-400">پوزیشن فعال ربات</div>
            <div id="active-position" class="text-xs font-semibold text-gray-200 mt-2">بدون معامله باز</div>
            <div id="pos-pnl" class="text-xs font-bold mt-1 text-gray-400">PnL: $0.00</div>
        </div>
    </div>

    <!-- Manual Trade Buttons -->
    <div class="grid grid-cols-2 gap-3">
        <button onclick="triggerAction('buy')" class="w-full py-2.5 rounded-xl bg-emerald-600/90 hover:bg-emerald-500 font-bold text-xs text-white transition flex items-center justify-center gap-1">
            ↑ خرید دستی 0.02 BTC
        </button>
        <button onclick="triggerAction('sell')" class="w-full py-2.5 rounded-xl bg-rose-600/90 hover:bg-rose-500 font-bold text-xs text-white transition flex items-center justify-center gap-1">
            ↓ فروش دستی 0.02 BTC
        </button>
    </div>

    <!-- Recent Trades & System Logs -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="glass-panel p-3 rounded-2xl">
            <div class="text-xs font-bold text-gray-400 mb-2">📜 تاریخچه معاملات بسته شده</div>
            <div id="trades-container" class="text-[11px] space-y-1.5 max-h-32 overflow-y-auto text-gray-300">
                <p class="text-gray-500">هنوز معامله‌ای ثبت نشده است.</p>
            </div>
        </div>
        <div class="glass-panel p-3 rounded-2xl">
            <div class="text-xs font-bold text-gray-400 mb-2">⚡️ رویدادهای زنده سیستم</div>
            <div id="logs-container" class="font-mono text-[10px] space-y-1 max-h-32 overflow-y-auto text-emerald-400/90">
                <p>در انتظار لاگ...</p>
            </div>
        </div>
    </div>

    <script>
        const ctx = document.getElementById('priceChart').getContext('2d');
        const priceChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: Array(25).fill(''),
                datasets: [{
                    label: 'BTC/USDT',
                    data: Array(25).fill(63400),
                    borderColor: '#10b981',
                    borderWidth: 2,
                    tension: 0.35,
                    pointRadius: 1,
                    fill: true,
                    backgroundColor: 'rgba(16, 185, 129, 0.08)'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { display: false },
                    y: { 
                        grid: { color: 'rgba(255, 255, 255, 0.05)' },
                        ticks: { color: '#6b7280', font: { size: 9 } }
                    }
                }
            }
        });

        async function fetchTelemetry() {
            try {
                const res = await fetch('/api/telemetry');
                const data = await res.json();
                
                document.getElementById('btc-price').innerText = '$' + data.btc_price;
                document.getElementById('total-equity').innerText = '$' + data.total_equity;
                document.getElementById('reserve-vault').innerText = '$' + data.reserve_usdt;
                document.getElementById('win-rate-stat').innerText = `${data.win_rate} (${data.total_profit_usdt})`;
                
                document.getElementById('rsi-val').innerText = data.rsi;
                document.getElementById('trend-val').innerText = data.trend;

                const pos = data.position;
                if (pos.side !== 'FLAT') {
                    document.getElementById('active-position').innerText = `${pos.side} (${pos.amount} BTC @ ${pos.entry_price})`;
                    const pnlVal = parseFloat(pos.pnl);
                    const pnlElem = document.getElementById('pos-pnl');
                    pnlElem.innerText = `PnL: ${pnlVal >= 0 ? '+' : ''}${pnlVal.toFixed(2)} USDT [TP: ${pos.tp} | SL: ${pos.sl}]`;
                    pnlElem.className = `text-xs font-bold mt-1 ${pnlVal >= 0 ? 'text-emerald-400' : 'text-rose-400'}`;
                } else {
                    document.getElementById('active-position').innerText = 'بدون معامله باز (در حال تحلیل)';
                    document.getElementById('pos-pnl').innerText = 'PnL: $0.00';
                    document.getElementById('pos-pnl').className = 'text-xs font-bold mt-1 text-gray-500';
                }

                // Update Chart
                const currPrice = parseFloat(data.btc_price.replace(/,/g, ''));
                priceChart.data.datasets[0].data.push(currPrice);
                priceChart.data.datasets[0].data.shift();
                priceChart.update('none');

                // Update Trades
                const tradesContainer = document.getElementById('trades-container');
                if (data.recent_trades.length > 0) {
                    tradesContainer.innerHTML = data.recent_trades.map(t => `
                        <div class="flex justify-between border-b border-gray-800 pb-1">
                            <span>[${t.time}] ${t.action}</span>
                            <span class="${t.pnl.includes('+') ? 'text-emerald-400' : 'text-rose-400'} font-bold">${t.pnl}</span>
                        </div>
                    `).join('');
                }

                // Update Logs
                const logsContainer = document.getElementById('logs-container');
                logsContainer.innerHTML = data.logs.slice(-15).reverse().map(l => `<div>${l}</div>`).join('');

            } catch (err) {
                console.error("Telemetry fetch error:", err);
            }
        }

        async function triggerAction(action) {
            await fetch('/api/action', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: action, amount: 0.02 })
            });
            fetchTelemetry();
        }

        setInterval(fetchTelemetry, 1800);
        fetchTelemetry();
    </script>
</body>
</html>
