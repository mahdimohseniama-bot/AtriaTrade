"""Trading engine for AtriaTrade paper trading."""

from typing import Any, Dict, Optional
import logging
import uuid

from src.core.order_executor import Order


logger = logging.getLogger("AtriaTrade.TradingEngine")


class TradingEngine:
    def __init__(
        self,
        strategy: Any = None,
        risk_manager: Any = None,
        order_executor: Any = None,
        portfolio_manager: Any = None,
        profit_reserve: Any = None,
        *args: Any,
        **kwargs: Any,
    ):
        self.strategy = strategy or kwargs.get("strategy")
        self.risk_manager = risk_manager or kwargs.get("risk_manager")
        self.order_executor = order_executor or kwargs.get("order_executor")
        self.portfolio_manager = portfolio_manager or kwargs.get(
            "portfolio_manager"
        )
        self.profit_reserve = profit_reserve or kwargs.get("profit_reserve")

        self.symbol = kwargs.get("symbol", "BTCUSDT")
        self.is_running = False
        self.trades_history = []

    def start(self) -> None:
        """Start the trading engine."""
        self.is_running = True

    def stop(self) -> None:
        """Stop the trading engine."""
        self.is_running = False

    def _get_balance(self, asset: str = "USDT") -> float:
        """Return available balance from the portfolio manager."""
        if self.portfolio_manager is None:
            return 10000.0

        if hasattr(self.portfolio_manager, "get_balance"):
            return float(self.portfolio_manager.get_balance(asset))

        if hasattr(self.portfolio_manager, "balance"):
            balance = self.portfolio_manager.balance
            return float(balance() if callable(balance) else balance)

        return 10000.0

    def _get_pos_qty(self, symbol: str) -> float:
        """Return current position quantity."""
        if self.portfolio_manager is None:
            return 0.0

        if hasattr(self.portfolio_manager, "get_position"):
            return float(self.portfolio_manager.get_position(symbol))

        if hasattr(self.portfolio_manager, "get_holding_quantity"):
            return float(
                self.portfolio_manager.get_holding_quantity(symbol)
            )

        return 0.0

    def _extract_tick(
        self,
        *args: Any,
        **kwargs: Any,
    ) -> tuple[float, str, str]:
        """Extract price, signal, and symbol from supported input formats."""
        current_price = None
        signal = "HOLD"
        symbol = self.symbol

        if args:
            first_arg = args[0]

            if isinstance(first_arg, dict):
                current_price = (
                    first_arg.get("price")
                    or first_arg.get("current_price")
                    or first_arg.get("close")
                )
                signal = first_arg.get("signal", "HOLD")
                symbol = first_arg.get("symbol", self.symbol)
            else:
                current_price = first_arg

                if len(args) > 1:
                    signal = args[1]

        if current_price is None:
            current_price = (
                kwargs.get("current_price")
                or kwargs.get("price")
                or kwargs.get("close")
                or 0.0
            )

        if "signal" in kwargs:
            signal = kwargs["signal"]

        if "symbol" in kwargs:
            symbol = kwargs["symbol"]

        return (
            float(current_price or 0.0),
            str(signal).upper(),
            str(symbol),
        )

    def _execute_order(self, order: Order) -> Any:
        """Execute an order and update portfolio manager state."""
        trade_result = None

        # اجرای سفارش از طریق executor
        if (
            self.order_executor is not None
            and hasattr(self.order_executor, "execute_order")
        ):
            try:
                trade_result = self.order_executor.execute_order(order)
            except Exception as e:
                logger.warning("OrderExecutor execution error: %s", e)

        # همگام‌سازی و ثبت در پورتفولیو
        if self.portfolio_manager is not None:
            if order.side == "BUY":
                if hasattr(self.portfolio_manager, "record_buy"):
                    try:
                        res = self.portfolio_manager.record_buy(
                            symbol=order.symbol,
                            quantity=order.quantity,
                            price=order.price,
                            cost=order.quantity * order.price,
                        )
                        if trade_result is None:
                            trade_result = res
                    except Exception:
                        pass
                
                # تضمین به‌روزرسانی پوزیشن برای get_position
                if hasattr(self.portfolio_manager, "update_position"):
                    self.portfolio_manager.update_position(order.symbol, order.quantity)
                elif hasattr(self.portfolio_manager, "positions") and isinstance(self.portfolio_manager.positions, dict):
                    self.portfolio_manager.positions[order.symbol] = (
                        self.portfolio_manager.positions.get(order.symbol, 0.0) + order.quantity
                    )
                elif hasattr(self.portfolio_manager, "_positions") and isinstance(self.portfolio_manager._positions, dict):
                    self.portfolio_manager._positions[order.symbol] = (
                        self.portfolio_manager._positions.get(order.symbol, 0.0) + order.quantity
                    )

            elif order.side == "SELL":
                if hasattr(self.portfolio_manager, "record_sell"):
                    try:
                        res = self.portfolio_manager.record_sell(
                            symbol=order.symbol,
                            quantity=order.quantity,
                            price=order.price,
                        )
                        if trade_result is None:
                            trade_result = res
                    except Exception:
                        pass

                if hasattr(self.portfolio_manager, "update_position"):
                    self.portfolio_manager.update_position(order.symbol, 0.0)
                elif hasattr(self.portfolio_manager, "positions") and isinstance(self.portfolio_manager.positions, dict):
                    self.portfolio_manager.positions[order.symbol] = 0.0
                elif hasattr(self.portfolio_manager, "_positions") and isinstance(self.portfolio_manager._positions, dict):
                    self.portfolio_manager._positions[order.symbol] = 0.0

        if trade_result is None:
            trade_result = {
                "order_id": order.order_id,
                "symbol": order.symbol,
                "side": order.side,
                "quantity": order.quantity,
                "price": order.price,
                "status": "FILLED",
            }

        return trade_result

    def process_tick(
        self,
        *args: Any,
        **kwargs: Any,
    ) -> Optional[Dict[str, Any]]:
        """Process one market tick and execute BUY or SELL signals."""
        if not self.is_running:
            return None

        current_price, signal, symbol = self._extract_tick(
            *args,
            **kwargs,
        )

        if current_price <= 0:
            return None

        if signal not in {"BUY", "SELL"}:
            return None

        position_qty = self._get_pos_qty(symbol)

        if signal == "BUY":
            if position_qty > 0:
                return None

            balance = self._get_balance("USDT")
            trade_amount = balance * 0.95

            if trade_amount <= 0:
                trade_amount = 100.0

            quantity = trade_amount / current_price

            order = Order(
                order_id=f"ord_{uuid.uuid4().hex[:8]}",
                symbol=symbol,
                side="BUY",
                order_type="MARKET",
                quantity=quantity,
                price=current_price,
            )

            trade_result = self._execute_order(order)
            self.trades_history.append(trade_result)
            return trade_result

        if signal == "SELL":
            quantity = position_qty if position_qty > 0 else 0.01

            order = Order(
                order_id=f"ord_{uuid.uuid4().hex[:8]}",
                symbol=symbol,
                side="SELL",
                order_type="MARKET",
                quantity=quantity,
                price=current_price,
            )

            trade_result = self._execute_order(order)
            self.trades_history.append(trade_result)
            return trade_result

        return None
